    <Style TargetType="Button" x:Key="SchooterBtn">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="/Images/scooter.png" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="20"/>
    </Style>

    <Style TargetType="Button" x:Key="BikeBtn">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="/Images/bike.png" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="25" />
    </Style>

    <Style TargetType="Button" x:Key="BinBtn">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="/Images/bin.png" Stretch="Fill"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#490B1A"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="20" />
    </Style>

    <Style TargetType="TextBox" x:Key="Captcha">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="Background" Value="#f5e6d6"/>
        <Setter Property="Foreground" Value="#6b1e2a"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontStretch" Value="UltraCondensed"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="BorderBrush" Value="#490B1A"/>
        <Setter Property="Background" Value="#e4a2a0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="Background" Value="#f5e6d6"/>
        <Setter Property="Foreground" Value="#6b1e2a"/>
        <Setter Property="Height" Value="27"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="BorderBrush" Value="#f5e6d6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#6b1e2a"/>
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
    </Style>
</ResourceDictionary>
    

     