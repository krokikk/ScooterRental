<Page x:Class="ScooterRental.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      xmlns:local="clr-namespace:ScooterRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DiagrammPage"
      Style="{DynamicResource dark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource StackBorder}" Padding="10" Margin="10">

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="⮜" Width="40" Height="40" HorizontalAlignment="Left" Click="BackButton_Click" ToolTip="Назад"/>
                    <TextBlock Text="Диаграммы поездок" Style="{StaticResource TextOutBorder2}" Margin="195,0,0,0"/>
                </StackPanel>
               
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Тип диаграммы:" Style="{StaticResource Text}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbDiagram" Width="150" SelectionChanged="UpdateChart"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Border2}" Margin="10">
            <WindowsFormsHost Margin="5" x:Name="ChartHost">
            </WindowsFormsHost>
        </Border>
    </Grid>
</Page>
