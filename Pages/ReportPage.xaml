<Page x:Class="ScooterRental.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ScooterRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportPage"
      Style="{DynamicResource dark}">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <Button Content="⮜" Width="40" Height="40" HorizontalAlignment="Left" Click="BackButton_Click" ToolTip="Назад"/>
            <TextBlock Text="Отчёты" Style="{StaticResource TextOutBorder}" FontSize="28" HorizontalAlignment="Center"/>
            <Button Content="Импорт в Word" Height="65" Width="300" FontSize="18" Click="WordButton_Click" ToolTip="Ипротр отчёта в word"/>
            <Button Content="Импорт в Excel" Height="65" Width="300" FontSize="18" Click="ExcelButton_Click" ToolTip="Ипротр отчёта в exel"/>
            <Button Content="Диаграмма" Height="65" Width="300" FontSize="18" Click="ChartButton_Click" ToolTip="Диаграмма"/>
        </StackPanel>
    </Grid>
</Page>
