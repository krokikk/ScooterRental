<Window x:Class="ScooterRental.Pages.BlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScooterRental.Pages"
        mc:Ignorable="d"
        Title="BlockWindow" Height="150" Width="300">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вы заблокированы :(" HorizontalAlignment="Center" Style="{DynamicResource Text}"/>
            <Button Content="Написать в поддержку" Width="150" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
