<Window x:Class="ScooterRental.Pages.RedactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScooterRental.Pages"
        mc:Ignorable="d"
        Title="RedactWindow" Height="450" Width="800"
        Style="{DynamicResource win}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,17">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource StackBorder}" Margin="0,0,0,15">
                <TextBlock Text="Редактирование пользователя" Style="{StaticResource TextOutBorder2}" Margin="10"/>
            </Border>

            <Border Style="{StaticResource Border2}" Padding="20" Height="413" Margin="0,79,0,0" Grid.RowSpan="2" VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                        <TextBlock Text="ID пользователя" Style="{StaticResource Text}"/>
                        <TextBox x:Name="IDTB" IsReadOnly="True" Text="{Binding ID}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                        <TextBlock Text="ФИО" Style="{StaticResource Text}"/>
                        <TextBox x:Name="FIOTB" Text="{Binding FIO}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                        <TextBlock Text="Логин" Style="{StaticResource Text}"/>
                        <TextBox x:Name="LoginTB" Text="{Binding Login}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                        <TextBlock Text="Новый пароль" Style="{StaticResource Text}"/>
                        <PasswordBox x:Name="PasswordPB"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                        <TextBlock Text="Возраст" Style="{StaticResource Text}"/>
                        <DatePicker x:Name="AgeDP" SelectedDate="{Binding Age}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                        <TextBlock Text="Номер телефона" Style="{StaticResource Text}"/>
                        <TextBox x:Name="PhoneTB" Text="{Binding Number}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="5">
                        <TextBlock Text="Роль" Style="{StaticResource Text}"/>
                        <ComboBox x:Name="RoleCB" Margin="3" DisplayMemberPath="RoleName" SelectedValuePath="RoleID"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
                        <TextBlock Text="Статус пользователя" Style="{StaticResource Text}"/>
                        <ComboBox x:Name="StatusCB" Margin="3"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="5">
                        <TextBlock Text="Подписка" Style="{StaticResource Text}"/>
                        <ComboBox x:Name="SubCB" Margin="3" DisplayMemberPath="SubName" SelectedValuePath="SubID"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="5">
                        <TextBlock Text="Наличие штрафа" Style="{StaticResource Text}"/>
                        <CheckBox x:Name="IsFineCB" Content="Пользователь имеет штраф" Foreground="#6b1e2a" FontFamily="Comic Sans MS" Margin="3,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="5">
                        <TextBlock Text="Сумма штрафа" Style="{StaticResource Text}"/>
                        <TextBox x:Name="FineSumTB"/>
                    </StackPanel>

                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="Отмена" Width="110" Click="Cancel_Click" Style="{StaticResource ReverseButton}"/>
                <Button Content="Сохранить" Width="130" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
