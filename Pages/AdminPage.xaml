<Page x:Class="ScooterRental.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ScooterRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="900"
      Title="Страница администратора"
      Style="{DynamicResource dark}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="20*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="BorderAuth" Style="{DynamicResource StackBorder}" Background="#f59c6a" Margin="10">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Профиль" Margin="88,10,10,10" Style="{DynamicResource TextOutBorder2}"/>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Логин: " Style="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding Login}" x:Name="LoginTB" Style="{DynamicResource Text}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Имя: " Style="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding FIO}" Style="{DynamicResource Text}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Телефон: " Style="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding Phone_number}" Style="{DynamicResource Text}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Роль: " Style="{DynamicResource Text}"/>
                        <TextBlock Text="{Binding Roles.Name}" Style="{DynamicResource Text}"/>
                    </StackPanel>
                    <Button Content="Отчёты" Width="200" Margin="0,250,0,0" Click="Button_Click_1"/>
                    <Button  Content="Выйти из аккаунта" Click="LeaveButton_Click" Width="200"/>


                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="0,10,10,10" Style="{DynamicResource StackBorder}">
            <TabControl x:Name="Tab" Margin="5">
                <TabItem Header="Пользователи" IsSelected="True" Height="27" Margin="-2,-1,-2,0" VerticalAlignment="Top">
                    <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="LBUser">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FIO, StringFormat= ФИО: {0}}"/>
                                    <TextBlock Text="{Binding Login, StringFormat=Логин: {0}}"/>
                                    <TextBlock Text="{Binding Password, StringFormat=Пароль: {0}}"/>
                                    <TextBlock Text="{Binding UserStatus, StringFormat=Статус: {0}}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Редактировать" Click="Button_Click" Height="20" Width="100" HorizontalAlignment="Left"/>
                                        <Button Style="{DynamicResource BinBtn}" Click="DeleteButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                               
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="Отзывы" IsSelected="False">
                    <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="LBReview">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding User.Login, StringFormat=Пользователь: {0}}"/>
                                    <TextBlock Text="{Binding VechiclesID, StringFormat=Транспорт: {0}}"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Rate, StringFormat=Оценка: {0}}"/>
                                    <Button Content="Ответить" Height="20" Width="100" HorizontalAlignment="Left"/>
                                </StackPanel>
                                
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
