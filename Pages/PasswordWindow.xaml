<Window x:Class="ScooterRental.Pages.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScooterRental.Pages"
        mc:Ignorable="d"
        Title="PasswordWindow" Height="450" Width="800"
        Style="{DynamicResource win}">

    <Grid Margin="22">
        <Grid>
            <Border Style="{StaticResource StackBorder}"
            Margin="15"
            Padding="10">
                <StackPanel>
                    <TextBlock Text="Смена пароля" Style="{StaticResource TextOutBorder2}"/>
                    <TextBlock Text="Текущий пароль" Style="{StaticResource Text}"/>
                    <PasswordBox x:Name="PasswordPB" ToolTip="Введите текущий пароль"/>
                    <TextBlock Text="Новый пароль" Style="{StaticResource Text}"/>
                    <PasswordBox x:Name="NewPasswordPB" ToolTip="Введите новый пароль"/>
                    <TextBlock Text="Повторите новый пароль" Style="{StaticResource Text}" />
                    <PasswordBox x:Name="ConfirmPasswordPB" ToolTip="Повторите новый пароль"/>
                    <TextBlock x:Name="MessageTB" Style="{StaticResource Text}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Отмена" Width="100" Style="{StaticResource ReverseButton}" Click="Cancel_Click" ToolTip="Отменить смену пароля"/>
                        <Button Content="Сохранить" Width="120" Click="ChangePassword_Click" ToolTip="Сохранить изменения"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
