<Page x:Class="ScooterRental.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ScooterRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage"
      Style="{DynamicResource dark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "Auto"/>
            <RowDefinition Height = "Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Grid.Row="0" Text="АВТОРИЗАЦИЯ" Margin="20" Style="{DynamicResource TextOutBorder}"/>
            <Border Width="300" Style="{DynamicResource StackBorder}" Grid.Row="1">
                <StackPanel>
                    <TextBlock Text="Введите логин: "/>
                    <TextBox x:Name="LoginTB"/>
                    <TextBlock Text="Введите пароль: "/>
                    <PasswordBox x:Name="PasswordPB"/>

                    <Button Content="Войти" Click="Enter_Click" Margin="3,20,3,5" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Ещё нет аккаунта?" Style="{DynamicResource TextOutBorder}" Margin="0,247.5,0,0"/>
                <Button Content="Зарегистрироваться" Click="Reg_Click" Width="200"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
