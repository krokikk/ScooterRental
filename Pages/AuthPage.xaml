<Page x:Class="ScooterRental.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ScooterRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="590" d:DesignWidth="900"
      Title="Страница авторизации"
      Style="{DynamicResource dark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "Auto"/>
            <RowDefinition Height = "Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ChangeStyle" Click="ChangeTheme_Click" Content="Сменить тему" Margin="10" ToolTip="Смена темы приложения"/>
                <TextBlock Grid.Row="0" Text="АВТОРИЗАЦИЯ" HorizontalAlignment="Center" Margin="275,20,20,20" Style="{DynamicResource TextOutBorder}"/>
            </StackPanel>
            <Border x:Name="BorderAuth" Width="300" Style="{DynamicResource StackBorder}" Grid.Row="1" Visibility="Visible">
                <StackPanel>
                    <TextBlock x:Name="LoginText" Text="Введите логин: " Visibility="Visible" Style="{DynamicResource Text}"/>
                    <TextBox x:Name="LoginTB" Visibility="Visible" ToolTip="Поле для логина"/>
                    <TextBlock x:Name="PasswordText" Text="Введите пароль: " Visibility="Visible" Style="{DynamicResource Text}"/>
                    <PasswordBox x:Name="PasswordPB" Visibility="Visible" ToolTip="Поле для пароля"/>
                    <Button x:Name="AuthBt" Content="Войти" Click="Enter_Click" Margin="3,20,3,5" Visibility="Visible" Style="{DynamicResource ReverseButton}" ToolTip="Вход в приложение"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock x:Name="RegText" Text="Ещё нет аккаунта?" Style="{DynamicResource TextOutBorder}" Margin="0,241,0,0" Visibility="Visible"/>
                <Button x:Name="RegBt" Content="Зарегистрироваться" Click="Reg_Click" Width="200" Visibility="Visible" ToolTip="Перейти на страницу регистрации"/>
            </StackPanel>
            <Border Width="300" Style="{DynamicResource StackBorder}" Grid.Row="1" x:Name="BorderCapcha" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Введите капчу:" Name="Captcha" HorizontalAlignment="Left" Visibility="Collapsed" Style="{DynamicResource Text}"/>
                    <TextBox CommandManager.PreviewExecuted="textBox_PreviewExecuted" Visibility="Collapsed" x:Name="captcha" Height="42" VerticalAlignment="Top" Width="156" 
                             HorizontalAlignment="Center" IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource Captcha}"/>
                    <TextBox Visibility="Collapsed" x:Name="captchaInput" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="160"/>
                    <Button x:Name="submitCaptcha" Visibility="Collapsed" Height="34" Content="Подтвердить" ToolTip="Подтвердить ввод" Grid.Row="1" 
                            HorizontalAlignment="Center" Width="120" VerticalAlignment="Top" Click="submitCaptcha_Click" Style="{DynamicResource ReverseButton}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
